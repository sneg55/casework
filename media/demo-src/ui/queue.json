{
  "$schema": "../node_modules/testreel/recording-definition.schema.json",
  "url": "http://localhost:5273/",
  "viewport": { "width": 1440, "height": 810 },
  "outputFormat": "mp4",
  "cursor": { "enabled": true, "size": 30, "color": "#c0392b", "rippleColor": "#c0392b", "rippleSize": 46, "idleHide": false, "transitionMs": 650 },
  "steps": [
    { "action": "wait", "ms": 5000 },
    { "action": "hover", "selector": ".waiting p" },
    { "action": "wait", "ms": 3500 },
    { "action": "hover", "selector": ".figure" },
    { "action": "wait", "ms": 3500 },
    { "action": "hover", "selector": "button.total:has-text('failing')" },
    { "action": "wait", "ms": 1600 },
    { "action": "hover", "selector": "button.total:has-text('answered by the catalog')" },
    { "action": "wait", "ms": 1600 },
    { "action": "hover", "selector": "button.total.hi" },
    { "action": "wait", "ms": 2600 },
    { "action": "hover", "selector": ".segments button:has-text('Watching')" },
    { "action": "wait", "ms": 1800 },
    { "action": "hover", "selector": ".segments button:has-text('Closed')" },
    { "action": "wait", "ms": 3000 }
  ]
}
