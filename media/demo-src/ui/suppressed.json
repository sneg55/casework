{
  "$schema": "../node_modules/testreel/recording-definition.schema.json",
  "url": "http://localhost:5273/",
  "viewport": {
    "width": 1440,
    "height": 810
  },
  "outputFormat": "mp4",
  "cursor": {
    "enabled": true,
    "size": 30,
    "color": "#c0392b",
    "rippleColor": "#c0392b",
    "rippleSize": 46,
    "idleHide": false,
    "transitionMs": 650
  },
  "steps": [
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "scroll",
      "y": 230
    },
    {
      "action": "wait",
      "ms": 2500
    },
    {
      "action": "hover",
      "selector": ".apparatus button:has-text('already re-points')"
    },
    {
      "action": "wait",
      "ms": 2800
    },
    {
      "action": "hover",
      "selector": ".apparatus button:has-text('pre-production')"
    },
    {
      "action": "wait",
      "ms": 2200
    },
    {
      "action": "hover",
      "selector": ".apparatus button:has-text('credential is required')"
    },
    {
      "action": "wait",
      "ms": 2800
    },
    {
      "action": "click",
      "selector": ".apparatus button:has-text('already re-points')"
    },
    {
      "action": "wait",
      "ms": 6000
    }
  ]
}
