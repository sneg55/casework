# Optional. The narration key is normally read from the shell, which picks it up from
# ~/.config/secrets/openai.env via ~/.zshenv. Copy this file to .env only if you want a
# per-project key instead, then run: node --env-file=.env tts.mjs
# .env is gitignored. Never commit it.
OPENAI_API_KEY=sk-...
# Optional overrides:
# TTS_VOICE=sage
