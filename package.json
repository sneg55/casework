{
  "name": "casework",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "probe": "python3 scripts/probe_catalog.py",
    "capture": "python3 scripts/probe_catalog.py --jurisdiction California",
    "replay": "python3 scripts/probe_catalog.py --replay",
    "queue": "npm run build:cases -w @casework/mcp && npm run attribute -w @casework/mcp",
    "api": "npm run api -w @casework/mcp",
    "ui": "npm run dev -w @casework/ui",
    "lint": "biome ci . && eslint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p packages/mcp && tsc --noEmit -p packages/ui",
    "test": "vitest run --passWithNoTests",
    "test:py": "uv run pytest -q",
    "lint:py": "uv run ruff check scripts tests && uv run ruff format --check scripts tests",
    "check": "npm run lint && npm run typecheck && npm run test && npm run lint:py && npm run test:py && npm run lint:dashes",
    "lint:dashes": "python3 scripts/no_dashes.py"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@truefoundry/trueforge-core": "^0.1.4",
    "eslint": "^9.18.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}
