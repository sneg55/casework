# Every value here has a working default, so nothing in this file is required to run anything.
# Nothing loads a .env: these are shell environment variables, so export the ones you want to
# change. The model provider is configured in the TrueForge settings UI, not here.
#
# Relative paths resolve against the repository root, not the shell's cwd, so a workspace
# script finds data/runs wherever npm chose to run it from.

# The read API the queue and case screens fetch from. The UI's default matches it.
CASEWORK_API_PORT=8791

# Where the recipient registry lives. Holds addresses, never committed.
# Copy registry.example.json to this path to make cases approvable.
CASEWORK_REGISTRY_PATH=registry.local.json

# Where captured runs are read from and written to.
CASEWORK_RUN_DIR=data/runs

# Where an approved message is written, since no transport is wired.
CASEWORK_OUTBOX_DIR=data/outbox

# Optional. repo.inspect works unauthenticated; a token raises the GitHub API rate limit.
# GITHUB_TOKEN=

# The UI reads these at startup, from this file's own directory: vite.config.ts sets envDir to
# the repository root, so a copy in packages/ui/.env.local is not read. Unset, the dock says no
# harness is configured.
# The UI reaches the harness through the Vite proxy, because a standalone TrueForge sends no
# CORS headers. Set the origin, and leave the VITE_ var as the proxy path.
# CASEWORK_HARNESS_ORIGIN=http://localhost:8790
# VITE_CASEWORK_HARNESS_URL=/harness
# VITE_CASEWORK_HARNESS_TOKEN=
# VITE_CASEWORK_API=http://localhost:8791
